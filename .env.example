# ── docapp: переменные окружения для запуска на сервере ────────────────
# Скопируйте в .env (он в .gitignore) и заполните реальными значениями.
# systemd-юнит читает этот файл через EnvironmentFile.

# ── Общие ──────────────────────────────────────────────────────────────
# Путь к основной БД (сотрудники, анестезии). По умолчанию data/docapp.db.
DOCAPP_DB=data/docapp.db

# Требовать Secure-куки сессий. НА СЕРВЕРЕ ЗА TLS ОБЯЗАТЕЛЬНО =1.
DOCAPP_HTTPS_ONLY=1

# Адрес и порт uvicorn. По умолчанию 127.0.0.1:8000 (за reverse-proxy).
# Для доступа по локальной сети / отладки: DOCAPP_HOST=0.0.0.0
#DOCAPP_HOST=127.0.0.1
#DOCAPP_PORT=8000

# ── Консультант по приказам (RouterAI) ─────────────────────────────────
# Ключ API RouterAI — обязателен, иначе консультант отвечает ошибками.
CONSULT_API_KEY=

CONSULT_BASE_URL=https://routerai.ru/api/v1
CONSULT_LLM_MODEL=openai/gpt-4o-mini
CONSULT_EMBED_MODEL=openai/text-embedding-3-small
CONSULT_INDEX_DIR=data/consult
CONSULT_DOCS_DIR=data/consult/documents

# ── Потребности ────────────────────────────────────────────────────────
NEEDS_DB=data/needs/needs.db
NEEDS_CATALOG=data/needs/catalog.yaml

# Примечание: секрет подписи сессий генерируется автоматически
# в data/secret.key при первом запуске и переживает рестарты
# (переносите его вместе с данными при миграции).
