# ── docapp: переменные окружения для запуска на сервере ────────────────
# Скопируйте в .env (он в .gitignore) и заполните реальными значениями.
# systemd-юнит читает этот файл через EnvironmentFile.

# ── Общие ──────────────────────────────────────────────────────────────
# ЕДИНАЯ база данных приложения: сотрудники, анестезии, «Чат»,
# «Потребности» и «Дежурства» живут в одном файле (ADR-0016).
# По умолчанию data/docapp.db.
DOCAPP_DB=data/docapp.db

# Требовать Secure-куки сессий. НА СЕРВЕРЕ ЗА TLS ОБЯЗАТЕЛЬНО =1.
DOCAPP_HTTPS_ONLY=1

# Хэш выложенной ревизии для бейджа в шапке. Обычно не нужен: на сервере
# записывается scripts/git-update.sh в файл REVISION, в разработке берётся из git.
#DOCAPP_GIT_REVISION=

# Адрес и порт uvicorn. По умолчанию 127.0.0.1:8000 (за reverse-proxy).
# Для доступа по локальной сети / отладки: DOCAPP_HOST=0.0.0.0
#DOCAPP_HOST=127.0.0.1
#DOCAPP_PORT=8000

# ── Чат (RouterAI) ─────────────────────────────────────────────────────
# Ключ API RouterAI — обязателен, иначе «Чат» отвечает ошибками.
AI_API_KEY=

AI_BASE_URL=https://routerai.ru/api/v1
AI_LLM_MODEL=openai/gpt-5.4-mini
AI_VISION_MODEL=qwen/qwen3.7-flash

# Папка PDF-источников «Чата» (файлами на диске, ADR-0020; раньше
# источники лежали BLOB-ом в БД — прежние переносит `docapp import-legacy`).
WIKI_SOURCES_DIR=data/wiki/sources

# ── Потребности ────────────────────────────────────────────────────────
# Файл-каталог расходки (базы, точки, группы, препараты, единицы). Источник
# правды — таблицы needs_catalog_* в БД (ADR-0019); файл нужен для первичного
# заполнения пустой базы (seed) и выгрузки через /needs/api/catalog/export.
NEEDS_CATALOG=data/needs/catalog.yaml

# ── Дежурства ──────────────────────────────────────────────────────────
# Часовой пояс смены (окно 16:00–09:30 считается по нему). По умолчанию
# Москва (UTC+3). При отсутствии tz-базы откатывается на фиксированный +3.
#DUTY_TZ=Europe/Moscow

# ── Распределение ──────────────────────────────────────────────────────
# Папка прогона ведомости: результат (run.xlsx) и его метаданные (run.json)
# лежат там до следующего прогона (ADR-0027). В файлах — ФИО пациентов,
# поэтому папка не попадает ни в git, ни в бэкап: прогон восстановим повторной
# загрузкой того же файла, а метки «учтена» живут в БД и бэкапятся.
DISTRIBUTION_DIR=data/distribution

# Примечание: секрет подписи сессий генерируется автоматически
# в data/secret.key при первом запуске и переживает рестарты
# (переносите его вместе с данными при миграции).
